    "Spend your coins on hints, undos and new candy styles.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besteed je munten aan hints, zetten terugnemen en nieuwe snoepstijlen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deine Münzen für Tipps und neue Bonbon-Stile aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépense tes pièces en indices et nouveaux styles de bonbons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasta tus monedas en pistas y nuevos estilos de caramelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaste suas moedas em dicas e novos estilos de doce."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetonlarını ipuçlarına ve yeni şeker stillerine harca."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belanjakan koinmu untuk petunjuk dan gaya permen baru."
          }
        }
      }
    },
