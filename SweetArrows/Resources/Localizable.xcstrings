    "Chocolate bars are two cells long and fly as one.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chocoladerepen zijn twee vakjes lang en vliegen als één geheel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schokoriegel sind zwei Felder lang und fliegen als Ganzes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les barres de chocolat font deux cases et volent d'un seul bloc."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las barras de chocolate ocupan dos casillas y vuelan juntas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As barras de chocolate ocupam duas casas e voam juntas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çikolata barları iki kare uzunluğundadır ve tek parça uçar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batang cokelat panjangnya dua kotak dan terbang sebagai satu."
          }
        }
      }
    },
