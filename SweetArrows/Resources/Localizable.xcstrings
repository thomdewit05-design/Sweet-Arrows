          "stringUnit": {
            "state": "translated",
            "value": "每天回來，獎勵更甜！"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日来ると、ごほうびがもっと甘くなるよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 오면 더 달콤한 보상이 기다려요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заходите каждый день за более сладкими наградами."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عد كل يوم لمكافآت أحلى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़्यादा मीठे इनाम के लिए रोज़ आइए।"
          }
        },
        "it": {
          "stringUnit": {
