    "Today's board, the season and the weekly tournament at a glance.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bord van vandaag, het seizoen en het weektoernooi in één oogopslag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Brett von heute, die Saison und das Wochenturnier auf einen Blick."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plateau du jour, la saison et le tournoi de la semaine en un coup d'œil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero de hoy, la temporada y el torneo semanal de un vistazo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tabuleiro do dia, a temporada e o torneio semanal num relance."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün tahtası, sezon ve haftalık turnuva tek bakışta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Papan hari ini, musim, dan turnamen mingguan sekilas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到今日棋盘、赛季和每周锦标赛。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到今日棋盤、賽季和每週錦標賽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のボード、シーズン、週間トーナメントをひと目で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 보드, 시즌, 주간 토너먼트를 한눈에."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле дня, сезон и недельный турнир — с одного взгляда."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لوحة اليوم والموسم والبطولة الأسبوعية في لمحة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज का बोर्ड, सीज़न और साप्ताहिक टूर्नामेंट एक नज़र में।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tabellone di oggi, la stagione e il torneo settimanale a colpo d'occhio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejsza plansza, sezon i turniej tygodnia w jednym miejscu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn chơi hôm nay, mùa giải và giải đấu tuần trong nháy mắt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระดานวันนี้ ซีซั่น และทัวร์นาเมนต์ประจำสัปดาห์ในพริบตา"
          }
        }
      }
    },
