    "Spinners turn their arrow a quarter turn after every move.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draaisnoepjes draaien hun pijl een kwartslag na elke zet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehbonbons drehen ihren Pfeil nach jedem Zug um eine Vierteldrehung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les toupies tournent leur flèche d'un quart de tour après chaque coup."
          }
