    "A new backdrop comes free at levels 3, 6, 10 and 15.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op niveau 3, 6, 10 en 15 krijg je gratis een nieuwe achtergrond."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Level 3, 6, 10 und 15 gibt es gratis einen neuen Hintergrund."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouveau décor offert aux niveaux 3, 6, 10 et 15."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fondo nuevo gratis en los niveles 3, 6, 10 y 15."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um cenário novo grátis nos níveis 3, 6, 10 e 15."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3, 6, 10 ve 15. seviyelerde yeni arka plan bedava."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latar baru gratis di level 3, 6, 10, dan 15."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 3、6、10 和 15 级可免费获得新背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 3、6、10 和 15 級可免費獲得新背景。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レベル3・6・10・15で新しい背景が無料でもらえます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레벨 3, 6, 10, 15에서 새 배경을 무료로 받아요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На уровнях 3, 6, 10 и 15 новый фон — бесплатно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحصل على خلفية جديدة مجانًا في المستويات 3 و6 و10 و15."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेवल 3, 6, 10 और 15 पर नया बैकग्राउंड मुफ़्त मिलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo sfondo in regalo ai livelli 3, 6, 10 e 15."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe tło za darmo na poziomach 3, 6, 10 i 15."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận miễn phí hình nền mới ở cấp 3, 6, 10 và 15."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับฉากหลังใหม่ฟรีที่เลเวล 3, 6, 10 และ 15"
          }
        }
      }
    },
    "A new board is ready!": {
