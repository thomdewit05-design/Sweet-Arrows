    "Tap the candy: it slides where its arrow points.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het snoepje: het glijdt waar de pijl heen wijst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Bonbon: Es gleitet in Pfeilrichtung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche le bonbon : il glisse dans le sens de sa flèche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el caramelo: se desliza hacia donde apunta su flecha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no doce: ele desliza para onde a seta aponta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şekere dokun: okunun gösterdiği yöne kayar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk permennya: ia meluncur ke arah panahnya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下糖果：它会朝箭头方向滑动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下糖果：它會朝箭頭方向滑動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンディをタップ：矢印の方向にすべるよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사탕을 탭하세요: 화살표 방향으로 미끄러져요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми на конфету: она скользит туда, куда смотрит стрелка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الحلوى: ستنزلق باتجاه سهمها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैंडी पर टैप करें: यह तीर की दिशा में खिसकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca la caramella: scivola dove punta la freccia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij cukierek: przesunie się tam, gdzie wskazuje strzałka."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào viên kẹo: nó trượt theo hướng mũi tên."
          }
        },
        "th": {
