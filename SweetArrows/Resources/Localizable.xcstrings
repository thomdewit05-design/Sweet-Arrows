    },
    "No more interstitials, banners or app-open ads. Rewarded stays optional.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen tussenadvertenties, banners of opstartadvertenties meer. Beloningsvideo's blijven optioneel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Zwischenwerbung, Banner oder Start-Werbung mehr. Belohnungsvideos bleiben freiwillig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de pubs interstitielles, bannières ou pubs à l'ouverture. Les vidéos récompensées restent facultatives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin anuncios intersticiales, banners ni anuncios al abrir. Los vídeos con recompensa siguen siendo opcionales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem anúncios intersticiais, banners ou anúncios de abertura. Vídeos premiados continuam opcionais."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
