    "Caramel needs two taps: the first cracks it, the second sends it flying.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karamel heeft twee tikken nodig: de eerste kraakt hem, de tweede laat hem vliegen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Karamell braucht zwei Tipper: Der erste knackt ihn, der zweite lässt ihn fliegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le caramel demande deux touches : la première le casse, la seconde le fait voler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El caramelo necesita dos toques: el primero lo rompe y el segundo lo hace volar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caramelo precisa de dois toques: o primeiro quebra, o segundo faz voar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karamel iki dokunuş ister: ilki kırar, ikincisi uçurur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Karamel butuh dua ketukan: yang pertama memecahkannya, yang kedua menerbangkannya."
          }
        }
      }
    },
