    "Wrapped sweets hide their color until their path is clear.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verpakte snoepjes laten hun kleur pas zien als de weg vrij is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verpackte Bonbons zeigen ihre Farbe erst, wenn ihr Weg frei ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bonbons emballés cachent leur couleur tant que leur chemin n'est pas libre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los caramelos envueltos ocultan su color hasta que su camino esté libre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Doces embrulhados escondem a cor até o caminho ficar livre."
          }
