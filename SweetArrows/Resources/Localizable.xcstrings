    "Stuck? Tap it to turn its arrow.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vast? Tik erop om de pijl te draaien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steckt fest? Tippe, um den Pfeil zu drehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqué ? Touche-le pour tourner sa flèche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Atascado? Tócalo para girar su flecha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Travou? Toque para girar a seta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıkıştı mı? Okunu çevirmek için dokun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Macet? Ketuk untuk memutar panahnya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡住了？点一下让箭头转向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡住了？點一下讓箭頭轉向。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動けない？タップして矢印を回そう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막혔나요? 탭해서 화살표를 돌려요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Застряла? Нажми, чтобы повернуть стрелку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عالقة؟ اضغط عليها لتدوير سهمها."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अटक गई? तीर घुमाने के लिए टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccata? Toccala per girare la freccia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utknął? Stuknij, by obrócić strzałkę."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bị kẹt? Chạm để xoay mũi tên."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดอยู่ใช่ไหม? แตะเพื่อหมุนลูกศร"
          }
        }
      }
    },
