    "Great! New candies keep coming. Don't let the board fill up!": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Top! Er blijven nieuwe snoepjes komen. Laat het bord niet vollopen!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Super! Es kommen immer neue Bonbons. Lass das Brett nicht volllaufen!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Super ! De nouveaux bonbons arrivent sans cesse. Ne laisse pas le plateau se remplir !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Genial! No paran de llegar caramelos. ¡Que no se llene el tablero!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo! Novos doces não param de chegar. Não deixe o tabuleiro encher!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika! Yeni şekerler gelmeye devam ediyor. Tahtanın dolmasına izin verme!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebat! Permen baru terus berdatangan. Jangan biarkan papannya penuh!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太棒了！新糖果会不断出现。别让棋盘被填满！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "太棒了！新糖果會不斷出現。別讓棋盤被填滿！"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいね！新しいキャンディがどんどん来るよ。ボードをいっぱいにしないでね！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아요! 새 사탕이 계속 나와요. 보드가 꽉 차지 않게 하세요!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отлично! Новые конфеты всё прибывают. Не дай полю заполниться!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رائع! الحلوى الجديدة لا تتوقف. لا تدع اللوحة تمتلئ!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बढ़िया! नई कैंडी आती रहेंगी। बोर्ड भरने मत देना!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimo! Arrivano sempre nuove caramelle. Non far riempire il tabellone!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Super! Cukierki wciąż przybywają. Nie daj zapełnić planszy!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuyệt! Kẹo mới sẽ liên tục xuất hiện. Đừng để bàn đầy nhé!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เยี่ยม! ลูกอมใหม่จะมาเรื่อยๆ อย่าให้กระดานเต็มนะ!"
          }
        }
      }
    },
