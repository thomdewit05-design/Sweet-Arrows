        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketli şekerler yolları açılana kadar renklerini gizler."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permen terbungkus menyembunyikan warnanya sampai jalannya bebas."
          }
        }
      }
