    "Classic runs count. Ends in %lld days.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klassieke potjes tellen mee. Eindigt over %lld dagen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klassische Runden zählen. Endet in %lld Tagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les parties classiques comptent. Fin dans %lld jours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuentan las partidas clásicas. Termina en %lld días."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Partidas clássicas contam. Termina em %lld dias."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasik oyunlar sayılır. %lld gün sonra biter."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permainan klasik dihitung. Berakhir dalam %lld hari."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经典模式计分。%lld 天后结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經典模式計分。%lld 天後結束。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラシックのスコアが対象。あと %lld 日で終了。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클래식 판이 집계돼요. %lld일 후 종료."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитываются классические забеги. Конец через %lld дн."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب الجولات الكلاسيكية. ينتهي خلال %lld يوم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लासिक राउंड गिने जाते हैं। %lld दिन में ख़त्म।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contano le partite classiche. Finisce tra %lld giorni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczą się klasyczne gry. Koniec za %lld dni."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính các ván cổ điển. Kết thúc sau %lld ngày."
          }
        },
        "th": {
