    "Your run is saved. Tap Play to carry on later.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je potje is bewaard. Tik later op Spelen om verder te gaan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Runde ist gespeichert. Tippe später auf Spielen, um weiterzumachen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta partie est sauvegardée. Touche Jouer plus tard pour continuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu partida está guardada. Toca Jugar más tarde para seguir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua partida está salva. Toque em Jogar depois para continuar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oyunun kaydedildi. Daha sonra devam etmek için Oyna'ya dokun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permainanmu tersimpan. Ketuk Main nanti untuk melanjutkan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本局已保存。稍后点击“开始”继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本局已儲存。稍後點擊「開始」繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイは保存されたよ。あとで「プレイ」をタップして続けよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "판이 저장됐어요. 나중에 플레이를 눌러 이어 하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забег сохранён. Нажми «Играть», чтобы продолжить позже."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ جولتك. اضغط على العب لاحقًا للمتابعة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका राउंड सेव हो गया। बाद में जारी रखने के लिए खेलें पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La partita è salvata. Tocca Gioca più tardi per continuare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gra zapisana. Stuknij Graj później, by kontynuować."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ván chơi đã được lưu. Chạm Chơi sau để chơi tiếp."
          }
        },
        "th": {
