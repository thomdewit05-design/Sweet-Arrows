    "Tap a candy to slide it. Line up 3 of a color!": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een snoepje om het te laten glijden. Zet er 3 van dezelfde kleur op een rij!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein Bonbon an, damit es rutscht. Bilde Reihen aus 3 gleichen Farben!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un bonbon pour le faire glisser. Aligne 3 bonbons de la même couleur !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un caramelo para deslizarlo. ¡Junta 3 del mismo color en línea!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num doce para deslizá-lo. Alinhe 3 da mesma cor!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırmak için bir şekere dokun. Aynı renkten 3 tanesini yan yana getir!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk permen untuk menggesernya. Jajarkan 3 yang warnanya sama!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击糖果让它滑动。把 3 颗同色糖果连成一排！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊糖果讓它滑動。把 3 顆同色糖果連成一排！"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンディをタップしてすべらせよう。同じ色を3つ並べよう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사탕을 탭해 미끄러뜨리세요. 같은 색 3개를 한 줄로!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на конфету, чтобы сдвинуть её. Соберите 3 одного цвета в ряд!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على حلوى لتنزلق. اصنع صفًا من 3 بنفس اللون!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैंडी पर टैप करें, वह फिसलेगी। एक रंग की 3 कैंडी लाइन में लाएँ!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una caramella per farla scivolare. Allinea 3 dello stesso colore!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij cukierek, aby go przesunąć. Ułóż 3 w jednym kolorze!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào kẹo để trượt. Xếp 3 viên cùng màu thành hàng!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะลูกกวาดให้ไถล เรียงสีเดียวกัน 3 เม็ดเป็นแถว!"
          }
        }
      }
    },
    "Tap a candy to smash it": {
