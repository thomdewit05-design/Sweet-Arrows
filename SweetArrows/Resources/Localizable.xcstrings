    "All done! Come back tomorrow for new missions.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles gehaald! Kom morgen terug voor nieuwe opdrachten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles geschafft! Komm morgen für neue Aufgaben wieder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est fait ! Reviens demain pour de nouvelles missions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Todo hecho! Vuelve mañana para nuevas misiones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo feito! Volte amanhã para novas missões."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsi tamam! Yeni görevler için yarın gel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua selesai! Kembali besok untuk misi baru."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部完成！明天再来领取新任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部完成！明天再來領取新任務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぜんぶクリア！明日また新しいミッションに挑戦しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 완료! 내일 새 미션을 받으러 오세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё выполнено! Возвращайтесь завтра за новыми заданиями."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنجزت كل شيء! عد غدًا لمهام جديدة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब पूरा! नए मिशन के लिए कल फिर आइए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto tutto! Torna domani per nuove missioni."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko zrobione! Wróć jutro po nowe misje."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xong hết rồi! Mai quay lại nhận nhiệm vụ mới nhé."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำครบแล้ว! พรุ่งนี้กลับมารับภารกิจใหม่นะ"
          }
        }
      }
    },
