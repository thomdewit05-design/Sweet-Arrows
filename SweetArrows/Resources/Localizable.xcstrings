            "value": "Tik op een snoepje: het schiet weg waar de pijl heen wijst!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Bonbon: Es fliegt dorthin, wohin sein Pfeil zeigt!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un bonbon : il file là où pointe sa flèche !"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un caramelo: ¡sale volando hacia donde apunta su flecha!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque num doce: ele voa para onde a seta aponta!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şekere dokun: oku nereyi gösteriyorsa oraya uçar!"
