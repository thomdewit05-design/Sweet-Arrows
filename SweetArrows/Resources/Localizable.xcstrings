    "Come back every day for sweeter rewards.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom elke dag terug voor nog zoetere beloningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm jeden Tag wieder für süßere Belohnungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviens chaque jour pour des récompenses plus sucrées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve cada día para recompensas más dulces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte todo dia para recompensas mais doces."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha tatlı ödüller için her gün gel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kembali setiap hari untuk hadiah yang lebih manis."
          }
        },
