    "No ads · 3 free hints every day · golden candy style · rewards without watching": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen advertenties · elke dag 3 gratis hints · gouden snoepstijl · beloningen zonder kijken"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Werbung · täglich 3 Gratis-Tipps · goldener Bonbon-Stil · Belohnungen ohne Video"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans pub · 3 indices gratuits par jour · style bonbon doré · récompenses sans vidéo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin anuncios · 3 pistas gratis al día · estilo dorado · recompensas sin ver vídeos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem anúncios · 3 dicas grátis por dia · estilo dourado · recompensas sem assistir"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklamsız · her gün 3 ücretsiz ipucu · altın şeker stili · izlemeden ödüller"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa iklan · 3 petunjuk gratis tiap hari · gaya permen emas · hadiah tanpa menonton"
          }
        }
      }
    },
