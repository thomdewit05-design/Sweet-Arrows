        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lutscherstangen bewegen sich nie. Bonbons müssen um sie herum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bâtons de sucette ne bougent jamais. Les bonbons doivent les contourner."
          }
