    "At most one a day: when your missions are ready or your streak is about to end.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooguit één per dag: als je opdrachten klaarstaan of je reeks bijna stopt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens eine pro Tag: wenn neue Missionen da sind oder deine Serie bald endet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une par jour au maximum : quand tes missions sont prêtes ou que ta série va s'arrêter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como mucho uno al día: cuando tus misiones estén listas o tu racha esté a punto de acabar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo um por dia: quando suas missões estiverem prontas ou sua sequência estiver para acabar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günde en fazla bir tane: görevlerin hazır olduğunda ya da serin bitmek üzereyken."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paling banyak sekali sehari: saat misimu siap atau rentetanmu hampir putus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天最多一次：任务已就绪或连续天数快要中断时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天最多一次：任務已就緒或連續天數快要中斷時。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日に1回まで：ミッションの準備ができた時や連続記録が途切れそうな時。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에 한 번만: 미션이 준비됐거나 연속 기록이 끊기려 할 때."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не чаще раза в день: когда готовы задания или серия вот-вот прервётся."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرة واحدة يوميًا على الأكثر: عندما تجهز مهامك أو توشك سلسلتك على الانقطاع."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन में ज़्यादा से ज़्यादा एक बार: जब मिशन तैयार हों या आपकी स्ट्रीक टूटने वाली हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo una al giorno: quando le missioni sono pronte o la serie sta per finire."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyżej raz dziennie: gdy misje są gotowe albo seria zaraz się skończy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối đa một lần mỗi ngày: khi nhiệm vụ đã sẵn sàng hoặc chuỗi ngày sắp đứt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันละไม่เกินหนึ่งครั้ง: เมื่อภารกิจพร้อมหรือสถิติต่อเนื่องใกล้จะขาด"
          }
        }
      }
    },
