    "1,000 coins and 3 of every booster. Only once.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "1.000 munten en 3 van elke booster. Eenmalig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1.000 Münzen und 3 von jedem Booster. Nur einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 000 pièces et 3 de chaque bonus. Une seule fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1000 monedas y 3 de cada potenciador. Solo una vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1.000 moedas e 3 de cada reforço. Só uma vez."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1.000 jeton ve her güçlendiriciden 3 tane. Sadece bir kez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1.000 koin dan 3 dari setiap booster. Hanya sekali."
          }
        }
      }
    },
