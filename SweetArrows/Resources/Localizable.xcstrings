    "Iced candies stay frozen until a neighbour leaves the board.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevroren snoepjes blijven vastzitten tot een buurman het bord verlaat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefrorene Bonbons bleiben stecken, bis ein Nachbar das Brett verlässt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bonbons gelés restent bloqués jusqu'à ce qu'un voisin quitte le plateau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los caramelos congelados no se mueven hasta que un vecino sale del tablero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Doces congelados ficam presos até um vizinho sair do tabuleiro."
          }
        },
        "tr": {
          "stringUnit": {
