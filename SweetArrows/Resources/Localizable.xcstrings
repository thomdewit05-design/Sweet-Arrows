    "Keep going? A third of the candies disappears.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorspelen? Een derde van de snoepjes verdwijnt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiterspielen? Ein Drittel der Bonbons verschwindet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer ? Un tiers des bonbons disparaît."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguir? Desaparece un tercio de los caramelos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar? Um terço dos doces desaparece."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam mı? Şekerlerin üçte biri kaybolur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjut? Sepertiga permen akan hilang."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续吗？三分之一的糖果会消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續嗎？三分之一的糖果會消失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける？キャンディの3分の1が消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속할까요? 사탕의 3분의 1이 사라져요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить? Треть конфет исчезнет."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تواصل؟ سيختفي ثلث الحلوى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखें? एक-तिहाई कैंडी गायब हो जाएँगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continui? Un terzo delle caramelle sparisce."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grać dalej? Zniknie jedna trzecia cukierków."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chơi tiếp? Một phần ba số kẹo sẽ biến mất."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เล่นต่อไหม? ลูกกวาดหนึ่งในสามจะหายไป"
          }
        }
      }
    },
