    "Bounced too often. Want three more hearts?": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te vaak gebotst. Wil je drie extra hartjes?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu oft abgeprallt. Drei Herzen extra?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de rebonds. Trois cœurs de plus ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebotaste demasiado. ¿Quieres tres corazones más?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quicou demais. Quer mais três corações?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla sektin. Üç kalp daha ister misin?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu sering memantul. Mau tiga hati lagi?"
          }
        }
      }
    },
